# Скопировать в .env и заполнить. .env в git не попадает.

# Токен с huggingface.co/settings/tokens.
# Нужен доступ на запись: туда уезжают чекпоинты и токенизатор.
HF_TOKEN=

# Куда huggingface складывает кэш. На Windows по умолчанию это C:, а он маленький.
HF_HOME=D:/hf-cache

# Namespace на HF, куда пушим артефакты проекта.
HF_NAMESPACE=sekund0chka
